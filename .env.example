# Supabase (hosted project pzyurpyqlsguvtexvpce).
# Copy to `.env.local` and fill in from
# https://supabase.com/dashboard/project/pzyurpyqlsguvtexvpce/settings/api-keys

# Public: shipped to the browser, safe by design (RLS decides access).
NEXT_PUBLIC_SUPABASE_URL=https://pzyurpyqlsguvtexvpce.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret: bypasses RLS. Build time / Node scripts only — never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Postgres connection string, used only by `npm run db:push` / `db:types`.
# Use the SESSION POOLER, not the direct host: db.<ref>.supabase.co is IPv6-only
# and is unreachable from networks without IPv6. The project region is eu-west-3.
# Percent-encode special characters in the password (@ : / ? # [ ] %).
SUPABASE_DB_URL=postgresql://postgres.pzyurpyqlsguvtexvpce:PASSWORD@aws-1-eu-west-3.pooler.supabase.com:5432/postgres
